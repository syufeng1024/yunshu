# Local development template. Copy to .env and change every credential before
# any shared or production environment. .env is git-ignored.
#
# The values below are the compose defaults from deploy/docker-compose.yml and
# are not valid production secrets.

# Process environment label written to every log line: dev | staging | prod.
ENV=dev

# Control-plane / jobs main database (read-write).
# The schema collation is utf8mb4_0900_as_cs (set by deploy/mysql/init). Do not
# add collation= to the DSN: go-sql-driver only whitelists a subset of
# collations, and column comparisons already use the schema collation.
# Keep the single quotes: make run-* sources this file with sh, and the DSN
# contains & characters.
DB_DSN='root:root@tcp(127.0.0.1:3306)/yunshu?parseTime=true&loc=UTC&charset=utf8mb4'

# Log database (same MySQL instance, separate schema in V1.0).
LOG_SQL_DSN='root:root@tcp(127.0.0.1:3306)/yunshu_log?parseTime=true&loc=UTC&charset=utf8mb4'

# The gateway's only main-database channel. It is capped by
# GATEWAY_DB_MAX_CONNS and must never become a general-purpose pool.
GW_WRITE_DSN='root:root@tcp(127.0.0.1:3306)/yunshu?parseTime=true&loc=UTC&charset=utf8mb4'

# Redis. Leave REDIS_PASSWORD empty for the local compose service.
REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=

# HTTP listeners. Defaults are :8080 (gateway) and :8081 (control plane).
# Override when the host already uses those ports (this machine: 8080 is taken
# by another project's container, so local .env sets :8082).
GATEWAY_HTTP_ADDR=:8080
CONTROL_HTTP_ADDR=:8081

# Metrics listeners, one port per process. They never share a port: a second
# process binding :9090 would fail and exit. When the token is empty the
# endpoint has no authentication and must stay on an internal interface.
GATEWAY_METRICS_ADDR=:9090
CONTROL_METRICS_ADDR=:9091
JOBSD_METRICS_ADDR=:9092
# Shared by all three processes; isolation comes from the port, not the token.
GATEWAY_METRICS_TOKEN=

# Gateway main-database channel size. Default 8; must be >= 1.
GATEWAY_DB_MAX_CONNS=8

# Cookie/session signing key. Replace before any non-local deployment.
SESSION_SECRET=dev-only-session-secret-change-before-deploy

# Channel upstream-key envelope KEK. Base64 of exactly 32 bytes (AES-256-GCM).
# Generate with: openssl rand -base64 32
# A missing/invalid value makes every upstream call return 503
# config_unavailable; there is no plaintext fallback. Never commit a
# production value.
CHANNEL_KEY_KEK=

# Device-fingerprint HMAC key for POST /api/console/trial/claim.
# The server stores HMAC-SHA256(raw fingerprint, this key); changing the key
# invalidates every existing fp_hash match. Empty makes the endpoint answer
# 503 config_unavailable, never hash with an empty secret.
FP_HMAC_KEY=dev-only-fp-hmac-key-change-before-deploy

# 内置超级管理员引导（controld 启动时执行，多副本并发安全，已存在则跳过）。
# 密码长度必须 8..72 字节，不合法会使 controld 拒绝启动；日志不会打印密码。
# 生产环境必须在首次启动前覆盖 ADMIN_BOOTSTRAP_PASSWORD，并在首登后立即修改。
# 默认口令 12345678 是公开弱口令：它只用来让首次部署能登录，不是可用口令。
# ADMIN_BOOTSTRAP_USERNAME 必须是用户名（3..32 字节、字母开头、仅 a-z0-9._-），
# 不能写邮箱或手机号；该值不接受角色变更，只创建 SUPER_ADMIN。
# ADMIN_BOOTSTRAP_DISABLED=true 完全跳过引导（存量环境已有超管时使用）。
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_PASSWORD=12345678
ADMIN_BOOTSTRAP_DISABLED=false

# 启动时自动迁移（只有 controld 读它）。留空 = 按 ENV 决定：dev / local 自动执行，
# 其它环境不执行（生产由 compose 的 migrate 服务或 k8s Job 先跑完）。
# 单机部署不想维护独立迁移任务时，可显式设 true —— 此时应用账号需要 DDL 权限。
# 多副本并发是安全的：启动迁移会先拿 MySQL 咨询锁（yunshu_auto_migrate），
# 拿不到锁的实例等待，随后发现没有待执行迁移，不会重复执行 DDL。
AUTO_MIGRATE=

# Console CSV export (T14). EXPORT_DIR defaults to os.TempDir()/yunshu-exports
# when empty. EXPORT_HMAC_KEY signs the 1-hour download token; leaving it empty
# makes POST /api/console/usage/export answer 503 config_unavailable instead of
# issuing an unsigned link. Never commit a production value.
EXPORT_DIR=
EXPORT_HMAC_KEY=dev-only-export-hmac-key-change-before-deploy

# Optional external content-safety checker (T42). Empty GW_POLICY_ENDPOINT
# leaves only the in-process keyword set; setting it adds the HTTP adapter.
# Contract: POST {"text":"..."} -> 2xx {"blocked":bool,"rule_id":...,
# "category":...,"offset":int,"length":int}. A timeout, non-2xx or unparseable
# body fails open (request forwarded) with a WARN and
# gw_content_policy_fail_open_total{reason}. Timeout is capped at 5000ms.
GW_POLICY_ENDPOINT=
GW_POLICY_TOKEN=
GW_POLICY_TIMEOUT_MS=800
